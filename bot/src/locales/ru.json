{
  "lang-alias": "ru",
  "lang-name": "Русский",
  "messages": {
    "start": {
      "msg": [
        "Здравствуйте {user}!\n",
        "Отправьте ссылку на трек или плейлист из Яндекс Музыки. 🎵\n\n",
        "Я помогу скачать трек или показать информацию о нём.\n",
        "Для справки используйте команду /help."
      ],
      "inline": {
        "1": {
          "/help": "command:help",
          "stats": "command:stats"
        }
      }
    },

    "help": {
      "msg": [
        "Доступные команды:\n\n",
        "/auth — подключить аккаунт Яндекс Музыки\n",
        "• Просто отправьте ссылку на Яндекс Музыку, чтобы получить трек\n",
        "• /now — отправить текущий проигрываемый трек\n\n",
        "Inline-режим (@botname…):\n",
        "• `audio` — отправить аудиофайл текущего трека\n",
        "• `text` — показать информацию о треке\n",
        "• `music.yandex.ru/…` — отправить трек по ссылке"
      ],
      "inline": {
        "1": {
          "Назад": "command:start"
        }
      }
    },

    "auth-request": {
      "msg": [
        "Пожалуйста, отправьте ваш API-ключ Яндекс Музыки.\n",
        "Вы можете отменить действие в любой момент с помощью /back."
      ],
      "inline": {
        "1": {
          "Как получить ключ?": "link::https://github.com/MarshalX/yandex-music-api/discussions/513#discussioncomment-2729781"
        }
      }
    },

    "auth-only-private": {
      "msg": [
        "В целях безопасности авторизация доступна только в личных сообщениях."
      ]
    },

    "auth-already": {
      "msg": [
        "API-ключ уже подключён.\n",
        "Хотите заменить его?"
      ],
      "key": {
        "1": ["Да", "Нет"]
      }
    },

    "auth-checkout": {
      "msg": [
        "Проверяем API-ключ, пожалуйста, подождите…"
      ]
    },

    "change-pm": "🗝️ Авторизация",

    "auth-checkout-fail": {
      "msg": [
        "Не удалось проверить указанный API-ключ.\n",
        "Пожалуйста, попробуйте снова с помощью /auth."
      ]
    },

    "auth-checkout-success": {
      "msg": [
        "Авторизация успешно завершена."
      ]
    },

    "auth-required": {
      "msg": [
        "Для продолжения требуется авторизация.\n",
        "Пожалуйста, используйте команду /auth."
      ],
      "inline": {
        "1": {
          "/auth": "command:auth"
        }
      }
    },

    "close-response": {
      "msg": [
        "Действие отменено."
      ]
    },

    "no-answer": {
      "msg": [
        "Хорошо."
      ]
    },

    "answers": {
      "yes": "да",
      "no": "нет"
    },

    "cancel": ["/back", "/close", "/cancel"],

    "inline-error": "Произошла ошибка",
    "error-fetching": "Произошла ошибка при получении трека.",

    "inline-audio": "Аудио",
    "send-audio": "`audio` — отправить аудиофайл",

    "inline-text": "Текст",
    "send-text": "`text` — отправить информацию о треке",

    "inline-link": "Трек по ссылке Я.М",
    "send-by-link": "`https://music.yandex.ru...` — получить текст или аудио по ссылке",

    "track-not-found": {
      "msg": [
        "К сожалению, запрошенный трек не найден."
      ]
    },

    "track-downloading": {
      "msg": [
        "Загружаю трек, пожалуйста, подождите…"
      ]
    },

    "track-fetch-error": {
      "msg": [
        "Произошла ошибка при получении трека."
      ]
    }
  }
}
